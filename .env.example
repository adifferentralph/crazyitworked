# Canonical application origin
NEXT_PUBLIC_APP_URL=https://twentytwoparts.com

# Supabase Connect panel: safe public browser credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase PostgreSQL transaction-pooler connection string (server and migration scripts only)
DATABASE_URL=

# Web Push VAPID credentials
# The public key is safe for browser subscription. Keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://twentytwoparts.com

# Kora Checkout Redirect (server-only; never prefix the secret with NEXT_PUBLIC_)
KORA_ENVIRONMENT=test
KORA_SECRET_KEY=

# Brevo transactional email API (server-only, opt-in live authentication tests)
# Supabase SMTP credentials belong in the Supabase dashboard, not this file.
BREVO_API_KEY=
